<Window x:Class="DupeSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DupeSweep"
        mc:Ignorable="d"
        Title="DupeSweep" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- 検索 -->
            <RowDefinition Height="Auto"/>
            <!-- Progress -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- メニュー -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open_Folder"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
        </Menu>

        <!-- 操作 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <TextBox Name="txtFolder" Width="500"/>
            <Button Name="btnBrowse" Content="参照" Margin="5,0,0,0" Click="BtnBrowse_Click"/>
            <Button Name="btnScan" Content="重複チェック" Margin="5,0,0,0"/>
            <Button Name="btnDelete" Content="削除" Margin="5,0,0,0" Click="BtnDelete_Click"/>
        </StackPanel>

        <ProgressBar Name="progressBar" Grid.Row="2" Margin="5" Minimum="0" Maximum="100" Height="20"/>

        <!-- 一覧 -->
        <DataGrid Name="gridFiles" Grid.Row="3" Margin="5" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}"/>
                <DataGridTextColumn Header="サイズ" Binding="{Binding Size}"/>
                <DataGridTextColumn Header="SHA256" Binding="{Binding Hash}" Width="250"/>
                <DataGridTextColumn Header="フルパス" Binding="{Binding FullPath}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="4">
            <TextBlock Name="txtStatus"/>
        </StatusBar>
    </Grid>
</Window>
